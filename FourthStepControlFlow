//Loops
//Ejercicio 1.1
fun main() {
    var pizzaSlices = 0
    while(pizzaSlices<7)
    {
        pizzaSlices++;
        println("There's only $pizzaSlices slice/s of pizza :(")
    }
    pizzaSlices++;
    println("There are $pizzaSlices slices of pizza. Hooray! We have a whole pizza! :D")
}

//Ejercicio 1.2
fun main() {
    var pizzaSlices = 0
    do 
    {
        pizzaSlices++;
        println("There's only $pizzaSlices slice/s of pizza :(")
    }while(pizzaSlices<7)
    pizzaSlices++;
    println("There are $pizzaSlices slices of pizza. Hooray! We have a whole pizza! :D")
}

//Ejercicio 2
fun main() {
    for(n in 1..100)
    {
        println(
            when
            {
                n%15 == 0 -> "fizzbuzz"
                n%3 == 0 -> "fizz"
                n%5 == 0 -> "buzz"
                else -> "$n"
            }
        )
    }
}

